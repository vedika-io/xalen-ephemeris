{
  "name": "@xalen/ephemeris",
  "version": "0.6.0",
  "description": "Node.js bindings for XALEN Ephemeris — pure-Rust astronomical & astrological computation (VSOP87 planets, Vedic/KP, houses, ayanamsa, panchang, numerology)",
  "license": "Apache-2.0",
  "author": "XALEN Technology Pvt Ltd",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/vedika-io/xalen-ephemeris#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/vedika-io/xalen-ephemeris.git",
    "directory": "crates/xalen-node"
  },
  "bugs": {
    "url": "https://github.com/vedika-io/xalen-ephemeris/issues"
  },
  "keywords": ["ephemeris", "astrology", "astronomy", "jyotish", "vedic", "napi", "swisseph", "pyswisseph", "panchang", "nakshatra", "horoscope"],
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "xalen",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test __test__/"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "files": ["index.js", "index.d.ts", "*.node", "README.md", "LICENSE"]
}
