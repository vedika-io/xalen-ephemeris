{
  "name": "xalen",
  "version": "0.1.0",
  "description": "Node.js bindings for XALEN Ephemeris — pure-Rust astronomical & astrological computation",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vedika-io/xalen-ephemeris.git",
    "directory": "crates/xalen-node"
  },
  "keywords": ["ephemeris", "astrology", "astronomy", "jyotish", "vedic", "napi"],
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "xalen",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test __test__/"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0"
  },
  "files": ["index.js", "index.d.ts", "*.node"]
}
